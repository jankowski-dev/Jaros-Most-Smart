# Переменные окружения для Ярик.Уроки

# Режим синтеза речи: 'browser' или 'yandex'
SPEECH_ENGINE=yandex

# Yandex SpeechKit (требуется для режима yandex)
YANDEX_PROXY_URL=https://jms.up.railway.app/api/tts
YANDEX_SPEECH_API_KEY=ваш_api_ключ_из_yandex_cloud
YANDEX_SPEECH_FOLDER_ID=ваш_folder_id

# Настройки голоса (опционально)
YANDEX_VOICE=alena          # alena, filipp, ermil
YANDEX_EMOTION=good         # good, evil, neutral
YANDEX_SPEED=1.0            # от 0.1 до 3.0

# Общие настройки (опционально)
SPEECH_ENABLED=true         # true или false
SPEECH_FALLBACK=true        # fallback на браузерный синтез
SPEECH_DEBUG=false          # включить отладку
